package javaPack;

public class Product //Product class that includes a constructor for initializing attributes
{
	//initialize variables
	private String name;
	private double price;
	private int quantity;
	
	public Product(String name, double price, int quantity)
	{
		this.name = name;
		this.price = price;
		this.quantity = quantity;
	}
	
	public String Name() 
	{
        return name;
    }
	
	public double Price() 
	{
        return price;
    }
	
	public int Quantity() 
	{
        return quantity;
    }
	
	public double TotalValue() 
	{
        return price * quantity;
    }
}
