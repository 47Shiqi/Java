//performs all calculations and displays a final receipt
package javaPack;

import java.util.ArrayList;
import java.util.Scanner;

public class Receipt extends MainRestaurant
{
	static Scanner allinput = new Scanner(System.in);
	private ArrayList<String> items = new ArrayList<>();
	private ArrayList<Double> prices = new ArrayList<>();
	private ArrayList<Integer> quantities = new ArrayList<>();
	double totalPrice = 0;
	
	public Receipt(ArrayList<String> myItems,ArrayList<Double> myPrices,ArrayList<Integer> myQuantities)
	{
		this.items = myItems;
		this.prices = myPrices;
		this.quantities = myQuantities;
	}
	
	public void printReceipt()
	{
		//print the receipt
		System.out.println("-----Receipt-----");
		for(int i=0; i<items.size(); i++)
		{
			double myprice = getPrice(prices.get(i),quantities.get(i)); // get the price of each order
			totalPrice = totalPrice + myprice; // add up prices
			System.out.println(quantities.get(i) + " " + items.get(i) + " - $" + myprice);
		}
		System.out.println("Total Price: $" + totalPrice);
		System.out.println("-----------------");
		System.out.print("Do you want to restart(Enter Y/Yes or N/No please)? ");
		Restart();
	}
	
	public double getPrice(double theprice, int thequantity)
	{
		return theprice * thequantity; 
	}
	
	public static void Restart()
	{
		String yesorno;
		yesorno = allinput.nextLine().toUpperCase();
		//check if the answer is yes or no
		if(yesorno.equals("YES") || yesorno.equals("Y"))
		{
			OrderMenu newOrder = new OrderMenu();
			MainRestaurant.main(null);
		}
		else if(yesorno.equals("NO") || yesorno.equals("N"))
		{
			System.out.println("Thank you! Bye!");
			System.exit(0);
		}
		else
		{
			System.out.print("Enter yes/y or no/n please: ");
			Restart(); //ask and checks again
		}
	}
}
