package javaPack;

public class DisplayMenu 
{
	private String breakfast[] = {"a","b","c"};
	private String lunch[] = {"d","e","f"};
	private String dinner[] = {"g","h","i"};
	private String category = "";
	
	public DisplayMenu(String mycategory)
	{
		category = mycategory;
	}
	
	public void Display()
	{
		switch(category)
		{
			case "1":
				categoryDisplay(breakfast);
				break;
			case "2":
				categoryDisplay(lunch);
				break;
			case "3":
				categoryDisplay(dinner);
				break;
			default:
				System.out.println("Opps, something went wrong...");
		}	
	}
	
	public void categoryDisplay(String[] arr)
	{
		for(int i=0; i<arr.length; i++)
		{
			System.out.println((i+1) + ". " + arr[i]);
		}
	}
}
