//displays all items of a specific category based on user input
package javaPack;

public class DisplayMenu extends MainRestaurant
{
	//initialize variables
	//menu info
	String breakfast[] = {"Waffles","Pancakes","Omelette"};
	String lunch[] = {"Cheeseburger","Chicken Sandwich","Chicken Salad"};
	String dinner[] = {"Grilled Salmon","Spaghetti","Vegetable Stir Fry"};
	double breakfastPrice[] = {5.50, 4.75, 6.25};
	double lunchPrice[] = {8.50, 7.75, 9.00};
	double dinnerPrice[] = {14.50, 12.50, 10.25};
	private String category = "";
	
	public DisplayMenu(String mycategory)
	{
		this.category = mycategory;
	}
	
	public void Display()
	{
		switch(category) //check the user input and match it with the correct category
		{
			case "1":
				categoryDisplay("Breakfast",breakfast,breakfastPrice);
				break;
			case "2":
				categoryDisplay("Lunch",lunch,lunchPrice);
				break;
			case "3":
				categoryDisplay("Dinner",dinner,dinnerPrice);
				break;
			default:
				System.out.println("Please enter 1, 2, or 3 only");
				MainRestaurant.main(null);
		}	
	}
	
	public void categoryDisplay(String category, String[] arr, double[] arrP)
	{
		System.out.println("-----" + category + "-----");
		for(int i=0; i<arr.length; i++) //print out every item in the array
		{
			System.out.println((i+1) + ". " + arr[i] + " - $" + arrP[i]);
		}
		//create a new OrderMenu object
		OrderMenu order = new OrderMenu(arr,arrP);
		order.AskMeal();
	}
}
