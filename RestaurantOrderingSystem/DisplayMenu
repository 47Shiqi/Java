package javaPack;

public class DisplayMenu 
{
	private String breakfast[] = {"bread","milk","cereals"};
	private String lunch[] = {"chicken","burger","sandwitch"};
	private String dinner[] = {"salad","soup","corn"};
	private double breakfastPrice[] = {2.50, 2.00, 3.75};
	private double lunchPrice[] = {10.50, 6.50, 5.25};
	private double dinnerPrice[] = {6.75, 5.50, 4.25};
	private String category = "";
	
	public DisplayMenu(String mycategory)
	{
		category = mycategory;
	}
	
	public void Display()
	{
		switch(category)
		{
			case "1":
				categoryDisplay("Breakfast",breakfast,breakfastPrice);
				break;
			case "2":
				categoryDisplay("Lunch",lunch,lunchPrice);
				break;
			case "3":
				categoryDisplay("Dinner",dinner,dinnerPrice);
				break;
			default:
				System.out.println("Opps, something went wrong...");
		}	
	}
	
	public void categoryDisplay(String category, String[] arr, double[] arrP)
	{
		System.out.println("-----" + category + "-----");
		for(int i=0; i<arr.length; i++)
		{
			System.out.println((i+1) + ". " + arr[i] + " - $" + arrP[i]);
		}
		OrderMenu order = new OrderMenu(arr,arrP);
		order.AskNum();
	}
}
