//collects and checks all input info
package javaPack;

import java.util.Scanner;

public class CollectInfo 
{
	//initialize variables
	static Scanner allinput = new Scanner(System.in);
	String name;
	int numSeats;
	int pickRow;
	int pickColumn;
	Theater myTheater = new Theater();
	
	public CollectInfo()
	{
		WelcomeMsg();
		AskInfo();	
	}
	
	public void WelcomeMsg()
	{
		System.out.println("Welcome to my movie theater!");
		myTheater.printSeats(); //use the method in Theater class
		System.out.println("You can reserve a seat or many seats in advance for free membership enrollment");
	}
	
	public void AskInfo()
	{
		CheckSeats(); //make sure there are still seats available
		System.out.println("We currently have " + (myTheater.seatTotal() - myTheater.seatReserved()) + " seats left(x - occupied; o - empty)");
		System.out.print("What is your name? ");
		name = getName();

		System.out.print("How many seats do you want to reserve? ");
		boolean ifTure = false;
		while(ifTure == false)
		{
			numSeats = getNum(); //get the input and check if it is a positive integer
			if(numSeats > (myTheater.seatTotal() - myTheater.seatReserved())) //check if it is within the range
			{
				System.out.print("We only have " + (myTheater.seatTotal() - myTheater.seatReserved()) + " seats left. Please try again: "); //ifTure still equals false, ask again
			}
			else
			{
				ifTure = true; //end the while loop
			}
		}
		
		for(int i=0; i<numSeats; i++)
		{
			System.out.print((i+1) + ") Pick a row(1-5): ");
			boolean truefalse = false;
			while(truefalse == false)
			{
				pickRow = getNum(); //get the input and check if it is a positive integer
				if(pickRow > myTheater.row()) //check if it is within the range
				{
					System.out.print("Pick a number from 1 to 5 please: "); //truefalse still equals false, ask again
				}
				else
				{
					truefalse = true; //end the while loop
				}
			}
			System.out.print((i+1) + ") Pick a column(1-59): ");
			truefalse = false;
			while(truefalse == false)
			{
				pickColumn = getNum();//get the input and check if it is a positive integer
				if(pickColumn > myTheater.column()) //check if it is within the range
				{
					System.out.print("Pick a number from 1 to 59 please: "); //truefalse still equals false, ask again
				}
				else
				{
					truefalse = true; //end the while loop
				}
			}
			boolean ifAvailable = myTheater.checkAvailability(pickRow,pickColumn,name); //use the method in Theater class
			if(ifAvailable)
			{
				System.out.println("Added!");
			}
			else
			{
				System.out.println("This seat is taken! Choose another seat please");
				i--; //do not increase i value and ask again
			}
		}
		myTheater.printSeats(); //display added seat(s)
		System.out.print("Would you like to reserved seats for another person(enter yes/y or no/n please)? ");
		AddAnother(); //ask if the user wants to add more seats
	}
	
	public void CheckSeats()
	{
		int seatsLeft = myTheater.seatTotal() - myTheater.seatReserved();
		if(seatsLeft == 0)
		{
			System.out.println("Thank you for your support. All seats are sold out.");
			System.exit(0); //end the program when all seats are sold out
		}
	}
	
	public String getName()
	{	
		String name = allinput.nextLine();
		boolean tORf = CheckName(name);
		while(tORf == false)
		{
			System.out.print("Invalid, please try again: ");
			name = allinput.nextLine();
	        tORf = CheckName(name);  //if invalid, ask to try entering again and call CheckName again
		}
		return name; //return the name when the input is valid
	}
	
	public boolean CheckName(String strName)
	{
		if(strName.equals("")) //check if it is blank
		{
			return false;
		}
		else
		{	
			return true;
		}
	}
	
	public int getNum()
	{	
		String strNumber = allinput.nextLine();
		boolean tORf = CheckNum(strNumber);
		while(tORf == false)
		{
			System.out.print("Invalid, please try again: ");
			strNumber = allinput.nextLine();
	        tORf = CheckNum(strNumber);  //if invalid, ask to try entering again and call CheckNum again
		}
		return Integer.parseInt(strNumber); //return the integer value when the input is valid
	}
	
	public boolean CheckNum(String strNum)
	{
		if(strNum.equals("") || strNum.equals("0")) //check if it is blank or = 0
		{
			return false;
		}
		else
		{	
			int len = strNum.length();
			for (int i = 0; i < len ; i++) 
			{
				if(strNum.charAt(i) < '0' || strNum.charAt(i) > '9')
				{
					return false; //check if every char is a number
				}
			}
		}
		return true;
	}
	
	public void AddAnother()
	{
		String yesorno;
		yesorno = allinput.nextLine().toUpperCase();
		//check if the answer is yes or no
		if(yesorno.equals("YES") || yesorno.equals("Y"))
		{
			AskInfo();
		}
		else if(yesorno.equals("NO") || yesorno.equals("N"))
		{
			System.out.println("Thank you! Bye!");
			System.exit(0);
		}
		else
		{
			System.out.print("Enter yes/y or no/n please: ");
			AddAnother();
		}
		
	}
}
