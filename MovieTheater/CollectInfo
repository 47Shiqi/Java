package javaPack;

import java.util.Scanner;

public class CollectInfo 
{
	static Scanner allinput = new Scanner(System.in);
	String[][] allSeats = new String[5][59];
	String name;
	int numSeats;
	int row = 5;
	int column = 59;
	int seatReserved = 100;
	int seatTotal = 295;
	int pickRow;
	int pickColumn;
	
	public CollectInfo()
	{
		AskInfo();
	}
	
	public void AskInfo()
	{
		System.out.println("Welcome to my movie theater!");
		initializeReservedSeats();
		printSeats();
		
		System.out.println("You can reserve a seat or many seats in advance for free membership enrollment");
		System.out.println("We currently have " + (seatTotal - seatReserved) + " seats left(x - occupied; o - empty)");
		
		System.out.print("What is your name? ");
		name = getName();
		
		System.out.print("How many seats do you want to reserve? ");
		boolean ifTure = false;
		while(ifTure == false)
		{
			numSeats = getNum();
			if(numSeats > (seatTotal-seatReserved)) //check if it is within the range
			{
				System.out.print("We only have " + (seatTotal - seatReserved) + " seats left. Please try again: "); //ifTure still equals false, ask again
			}
			else
			{
				ifTure = true; //end the while loop
			}
		}
		
		for(int i=0; i<numSeats; i++)
		{
			System.out.print((i+1) + ") Pick a row(1-5): ");
			boolean truefalse = false;
			while(truefalse == false)
			{
				pickRow = getNum();
				if(pickRow > row) //check if it is within the range
				{
					System.out.print("Pick a number from 1 to 5 please: "); //ifTure still equals false, ask again
				}
				else
				{
					truefalse = true; //end the while loop
				}
			}
			System.out.print((i+1) + ") Pick a column(1-59): ");
			truefalse = false;
			while(truefalse == false)
			{
				pickColumn = getNum();
				if(pickColumn > column) //check if it is within the range
				{
					System.out.print("Pick a number from 1 to 59 please: "); //ifTure still equals false, ask again
				}
				else
				{
					truefalse = true; //end the while loop
				}
			}
			boolean ifAvailable = checkAvailability(pickRow,pickColumn);
			if(ifAvailable)
			{
				allSeats[pickRow-1][pickColumn-1] = name;
				System.out.println("Added!");
			}
			else
			{
				System.out.println("This seat is taken! Choose another seat please");
				i--;
			}
		}
		printSeats();
	}
	
	public void initializeReservedSeats()
	{
		int theRow = 0;
		int theColumn = 0;
		for(int i=0; i<seatReserved; i++)
		{
			allSeats[theRow][theColumn] = "anonymous";
			if(theColumn == column - 1)
			{
				theColumn = 0;
				theRow++;
			}
			else
			{
				theColumn++;
			}
		}
	}
	
	public void printSeats()
	{
		System.out.print("   ");
		for(int i=1; i<=column; i++)
		{
			String stri = Integer.toString(i);
			if(stri.length() == 1)
			{
				System.out.print(i + "  ");
			}
			else
			{
				System.out.print(i + " ");
			}
			
		}
		System.out.println();
		
		for(int i=0; i<row; i++)
		{
			System.out.print((i+1) + "  ");
			for(int j=0; j<column; j++)
			{
				if(allSeats[i][j] == null)
				{
					System.out.print("o  ");
				}
				else
				{
					System.out.print("x  ");
				}
			}
			System.out.println();
		}
	}
	
	public String getName()
	{	
		String name = allinput.nextLine();
		boolean tORf = CheckName(name);
		while(tORf == false)
		{
			System.out.print("Invalid, please try again: ");
			name = allinput.nextLine();
	        tORf = CheckName(name);  //if invalid, ask to try entering again and call CheckName
		}
		return name; //return the name when the input is valid
	}
	
	public boolean CheckName(String strName)
	{
		if(strName.equals("")) //check if it is blank
		{
			return false;
		}
		else
		{	
			return true;
		}
	}
	
	public int getNum()
	{	
		String strNumber = allinput.nextLine();
		boolean tORf = CheckNum(strNumber);
		while(tORf == false)
		{
			System.out.print("Invalid, please try again: ");
			strNumber = allinput.nextLine();
	        tORf = CheckNum(strNumber);  //if invalid, ask to try entering again and call CheckNum
		}
		return Integer.parseInt(strNumber); //return the integer value when the input is valid
	}
	
	public boolean CheckNum(String strNum)
	{
		if(strNum.equals("") || strNum.equals("0")) //check if it is blank or = 0
		{
			return false;
		}
		else
		{	
			int len = strNum.length();
			for (int i = 0; i < len ; i++) 
			{
				if(strNum.charAt(i) < '0' || strNum.charAt(i) > '9')
				{
					return false; //check if every char is a number
				}
			}
		}
		return true;
	}
	
	public boolean checkAvailability(int x, int y)
	{
		if(allSeats[x][y] == null)
		{
			return true;
		}
		else
		{
			return false;
		}
	}
}
